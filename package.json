{
  "name": "fiatvoluntastua",
  "version": "1.0.0",
  "description": "bot telegram",
  "main": "index.js",
  "author": "Rafael Freitas",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docker:build": "docker build --no-cache --tag 'fiatvoluntastua' .",
    "docker:start": "docker run --name 'fiatvoluntastua' -v chat-data:/src/dist -d 'fiatvoluntastua'",
    "docker:stop": "docker stop 'fiatvoluntastua' && docker rm 'fiatvoluntastua'"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "grammy": "^1.16.1",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@types/node": "^22.19.11",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^16.0.3",
    "node-cron": "^4.2.1",
    "tsup": "^6.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
